+`timescale 1ns/1ps
+
+module accel_dp #(
+    parameter int unsigned AXI_ADDR_W = 32,
+    parameter int unsigned AXI_DATA_SIZE = 64,
+    parameter int FIFO_DEPTH = 16,
+    parameter int FIFO_THRESHOLD = 8,

+    .piso_rst_n,
+    .piso_load,
+    .piso_shift_en,
+    .piso_empty,
+    .ptr_stream_enable,
+    .ptr_stream_rst_n,
+    .segment_advance,
+    .segment_valid,
+    .segment_done,
+    .stream_end,
+    .end_rd_index,
+    .next_row_empty(),
+    .cnt_stage_en,
+    .cnt_stage_rst_n,
+    .cnt_comp_idx_en,
+    .cnt_comp_idx_rst_n
+);
+
+endmodule

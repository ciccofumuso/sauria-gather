+    .ADDR_W(AXI_ADDR_W),
+    .DATA_W(AXI_DATA_SIZE)
+) axi4_write (
+    .clk_i(clk),
+    .rst_ni(axi_wr_rst_n),
+    .start(buffer_out_valid),
+    .addr_in(axi_wr_aw_addr_in),
+    .len_in(buffer_rd_len),
+    .size_in(axi_wr_aw_size_in),
+    .data_in(buffer_data_out),
+    .w_strb_last(buffer_wstrb_last),
+    .next_data_out(buffer_out_ready),
+    .done(wr_done),
+    .aw_addr,
+    .aw_len,
+    .aw_size,
+    .aw_burst,
+    .aw_valid,

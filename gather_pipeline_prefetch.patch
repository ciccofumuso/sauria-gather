+logic buffer_out_ready;
+logic [AXI_DATA_SIZE-1:0] buffer_data_out;
+logic buffer_out_valid;
+logic [7:0] buffer_rd_len;
+logic [AXI_DATA_SIZE/8-1:0] buffer_wstrb_last;

--- a/RTL/sauria_subsystem.sv
+++ b/RTL/sauria_subsystem.sv
@@ -719,4 +719,50 @@
 
 
 
+
+`ifndef SYNTHESIS
+logic dbg_sauria_raw_q;
+logic dbg_sauria_sync_q;
+logic dbg_dma_r_q;
+logic dbg_dma_w_q;
+logic dbg_ctrl_done_q;
+logic dbg_gather_busy_q;
+logic dbg_gather_done_q;
+
+always_ff @(posedge i_system_clk) begin
+    if (!i_system_rstn) begin
+        dbg_sauria_raw_q   <= 1'b0;
+        dbg_sauria_sync_q  <= 1'b0;
+        dbg_dma_r_q        <= 1'b0;
+        dbg_dma_w_q        <= 1'b0;
+        dbg_ctrl_done_q    <= 1'b0;
+        dbg_gather_busy_q  <= 1'b0;
+        dbg_gather_done_q  <= 1'b0;
+    end else begin
+        if (dbg_gather_busy_q != gather_busy)
+            $display("[%0t] [SUBSYS] gather_busy %0b -> %0b", $time, dbg_gather_busy_q, gather_busy);
+        if (!dbg_gather_done_q && gather_doneintr)
+            $display("[%0t] [SUBSYS] gather_doneintr RISE", $time);
+        if (!dbg_dma_r_q && dma_rd_intr2control)
+            $display("[%0t] [SUBSYS] dma_reader_interrupt RISE", $time);
+        if (!dbg_dma_w_q && dma_wr_intr2control)
+            $display("[%0t] [SUBSYS] dma_writer_interrupt RISE", $time);
+        if (!dbg_sauria_raw_q && sauria_intr2cdc)
+            $display("[%0t] [SUBSYS] sauria_interrupt RAW RISE", $time);
+        if (!dbg_sauria_sync_q && sauria_intr2control)
+            $display("[%0t] [SUBSYS] sauria_interrupt CDC RISE", $time);
+        if (!dbg_ctrl_done_q && o_intr)
+            $display("[%0t] [SUBSYS] controller_done_interrupt RISE", $time);
+
+        dbg_sauria_raw_q  <= sauria_intr2cdc;
+        dbg_sauria_sync_q <= sauria_intr2control;
+        dbg_dma_r_q       <= dma_rd_intr2control;
+        dbg_dma_w_q       <= dma_wr_intr2control;
+        dbg_ctrl_done_q   <= o_intr;
+        dbg_gather_busy_q <= gather_busy;
+        dbg_gather_done_q <= gather_doneintr;
+    end
+end
+`endif
+
 endmodule 
